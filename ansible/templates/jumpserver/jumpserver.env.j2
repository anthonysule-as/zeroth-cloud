# Zeroth Cloud v3 — JumpServer Environment Configuration
# Managed by Ansible — DO NOT EDIT MANUALLY

# Core settings
SECRET_KEY={{ vault_jumpserver_secret_key }}
BOOTSTRAP_TOKEN={{ vault_jumpserver_bootstrap_token }}

# Database
DB_ENGINE=mysql
DB_HOST=db
DB_PORT=3306
DB_USER=jumpserver
DB_PASSWORD={{ vault_jumpserver_db_password }}
DB_NAME=jumpserver

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD={{ vault_jumpserver_redis_password }}

# Security
SESSION_COOKIE_AGE=86400
SESSION_EXPIRE_AT_BROWSER_CLOSE=True

# MFA enforcement — all analysts must use TOTP
MFA_FORCE_ENABLED=True
OTP_VALID_WINDOW=0

# Session recording
TERMINAL_RECORD_STORAGE_TYPE=server

# Server
HTTP_BIND_HOST=0.0.0.0
HTTP_LISTEN_PORT=8080
WS_LISTEN_PORT=8070

# Public URL — JumpServer uses this for redirects
DOMAINS={{ vault_jumpserver_public_ip }}
