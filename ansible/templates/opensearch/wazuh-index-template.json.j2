{
  "index_patterns": ["wazuh-alerts-*"],
  "priority": 500,
  "template": {
    "settings": { "number_of_shards": 1, "number_of_replicas": 1, "mapping.total_fields.limit": 5000 },
    "mappings": {
      "dynamic_templates": [
        { "strings_as_keyword": { "match_mapping_type": "string",
          "mapping": { "type": "text", "fields": { "keyword": { "type": "keyword", "ignore_above": 1024 } } } } }
      ],
      "properties": {
        "timestamp":  { "type": "date" },
        "@timestamp": { "type": "date" },
        "rule": { "properties": {
          "level": { "type": "long" }, "firedtimes": { "type": "long" }, "id": { "type": "keyword" },
          "description": { "type": "text", "fields": { "keyword": { "type": "keyword", "ignore_above": 1024 } } } } },
        "agent": { "properties": { "id": { "type": "keyword" }, "name": { "type": "keyword" }, "ip": { "type": "keyword" } } },
        "cluster": { "properties": { "name": { "type": "keyword" }, "node": { "type": "keyword" } } },
        "data": { "type": "object", "dynamic": true }
      }
    }
  }
}
