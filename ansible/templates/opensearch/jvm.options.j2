# Zeroth Cloud v3 — OpenSearch JVM Options
# Managed by Ansible — DO NOT EDIT MANUALLY
# Heap = 50% of available RAM, max 31g

-Xms{{ [((ansible_memtotal_mb * 0.5) | int), 31744] | min }}m
-Xmx{{ [((ansible_memtotal_mb * 0.5) | int), 31744] | min }}m

-XX:+UseG1GC
