# Generated: {{ ansible_date_time.iso8601 }}

# TheHive
THEHIVE_SECRET={{ vault_thehive_secret }}
THEHIVE_ADMIN_PASSWORD={{ vault_thehive_admin_password }}

# MISP
MISP_ADMIN_EMAIL={{ vault_misp_admin_email }}
MISP_ADMIN_PASSWORD={{ vault_misp_admin_password }}
MISP_DB_PASSWORD={{ vault_misp_db_password }}
MISP_DB_ROOT_PASSWORD={{ vault_postgresql_superuser_password }}
MISP_SALT={{ vault_misp_salt }}

# Cortex
CORTEX_SECRET={{ vault_cortex_secret }}
CORTEX_ADMIN_PASSWORD={{ vault_cortex_admin_password }}

# OpenSearch (for TheHive and Cortex connections)
OPENSEARCH_ADMIN_PASSWORD={{ vault_opensearch_admin_password }}
OPENSEARCH_HOST={{ hostvars[groups['opensearch'][0]]['wg_overlay_ip'] }}

# Shuffle
SHUFFLE_ADMIN_USERNAME={{ vault_shuffle_admin_username }}
SHUFFLE_ADMIN_PASSWORD={{ vault_shuffle_admin_password }}
