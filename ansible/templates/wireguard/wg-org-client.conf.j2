# Zeroth Cloud v3 — WireGuard Client Config for Org: {{ org_name }}
# Generated by enroll_org.yml — deliver to org via Signal or PGP-encrypted email.
# DELETE this file from the server after delivery.
#
# Org ID     : {{ org_id }}
# Subnet     : {{ wireguard_subnet }}
# Enrolled   : {{ ansible_date_time.date }}

[Interface]
# Assign any IP from the org's dedicated /24 subnet to this client
Address    = 10.{{ org_id }}.0.2/24
PrivateKey = {{ wg_org_private_key }}
DNS        = 1.1.1.1, 8.8.8.8

# ─── GATEWAY A — Site A (Primary) ────────────────────────────────────────────
[Peer]
PublicKey           = {{ vault_wg_gateway_a_public_key }}
Endpoint            = {{ wg_gateway_a_public_ip }}:{{ wireguard_listen_port }}
# Only route Wazuh traffic through the tunnel (split tunnel)
# Traffic to the Wazuh manager goes through VPN; all other internet traffic is direct.
AllowedIPs          = {{ wireguard_subnet }}, <REDACTED_IP_2>/24
PersistentKeepalive = 25

# ─── GATEWAY B — Site B (Automatic Failover) ─────────────────────────────────
[Peer]
PublicKey           = {{ vault_wg_gateway_b_public_key }}
Endpoint            = {{ wg_gateway_b_public_ip }}:{{ wireguard_listen_port }}
AllowedIPs          = {{ wireguard_subnet }}, <REDACTED_IP_2>/24
PersistentKeepalive = 25
