# Zeroth Cloud v3 — Grafana Configuration
# Managed by Ansible — DO NOT EDIT MANUALLY

[server]
http_port = {{ grafana_port }}
domain = {{ groups['monitoring'][0] }}
root_url = http://{{ groups['monitoring'][0] }}:{{ grafana_port }}

[database]
type = sqlite3
path = /data/grafana/grafana.db

[security]
admin_user = admin
admin_password = {{ vault_grafana_admin_password }}
secret_key = {{ vault_grafana_secret_key }}
disable_gravatar = true
cookie_secure = false
cookie_samesite = lax
strict_transport_security = true
x_content_type_options = true
x_xss_protection = true

[users]
allow_sign_up = false
allow_org_create = false
auto_assign_org = true
auto_assign_org_role = Viewer
default_theme = dark

[auth]
disable_login_form = false
oauth_auto_login = false

[auth.anonymous]
enabled = false

[analytics]
reporting_enabled = false
check_for_updates = false
check_for_plugin_updates = false

[log]
mode = file
level = warn
filters = rendering:error

[log.file]
log_rotate = true
max_lines = 1000000
max_size_shift = 28
daily_rotate = true
max_days = 7

[alerting]
enabled = false

[unified_alerting]
enabled = true

[feature_toggles]
enable = publicDashboards
